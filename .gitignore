# --- Python bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtualenv ---
.venv/
venv/
env/
ENV/

# --- Build / packaging ---
build/
dist/
*.egg-info/
.eggs/
wheelhouse/

# --- Test & tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Runtime data (app defaults live in XDG dirs, these are for local overrides) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
logs/
exports/

# --- Local config & secrets ---
.env
.env.*
!.env.example
*.local.toml

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Per-machine agent settings ---
.claude/settings.local.json
